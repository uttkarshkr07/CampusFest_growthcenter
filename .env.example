# Public (browser) keys: safe to deploy
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local only, used by scripts/import.mjs. NEVER deploy or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI copilot. Server only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional, comma separated, first is primary.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Sign-in. Set to on only after supabase/patch_session3a.sql and scripts/setup_logins.mjs.
NEXT_PUBLIC_AUTH_MODE=
# One shared password for the demo accounts, 10+ characters, used nowhere else.
# It ships inside the app, so anyone with the link can use any demo account.
NEXT_PUBLIC_DEMO_PASSWORD=
